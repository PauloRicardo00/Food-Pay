# ============================================================
# FoodPay — .gitignore
# Covers: .NET 8 / ASP.NET Core · React / Vite · Node.js
# ============================================================


# ────────────────────────────────────────────────────────────
# SEGREDOS E CONFIGURAÇÕES LOCAIS
# ────────────────────────────────────────────────────────────

# Arquivo de configuração com senhas, conexões e chaves de API
# NUNCA commitar estes arquivos
FoodPay.API/FoodPay.API/appsettings.json
FoodPay.API/FoodPay.API/appsettings.Development.json
FoodPay.API/FoodPay.API/appsettings.Production.json

# Variáveis de ambiente do frontend
Food-Pay/.env
Food-Pay/.env.local
Food-Pay/.env.*.local

# Certificados e chaves
*.pfx
*.p12
*.key
*.pem
*.cer


# ────────────────────────────────────────────────────────────
# .NET / C# / ASP.NET CORE
# ────────────────────────────────────────────────────────────

# Build outputs
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / VS Code
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
.idea/
*.swp

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!**/packages/repositories.config
*.nuspec

# Entity Framework Core
# Migrations são commitadas intencionalmente
# mas o snapshot de design-time não é necessário versionar

# Publicação
**/publish/
**/PublishProfiles/
**/Properties/PublishProfiles/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResult.xml
coverage.xml
*.trx
*.coverage
*.coveragexml

# User-specific files
*.rsuser
*.sln.ide

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Linux
*~
.nfs*


