vite.config.js.timestamp-*
vite.config.ts.timestamp-*


# ────────────────────────────────────────────────────────────
# EDITORES E IDES
# ────────────────────────────────────────────────────────────

# VS Code (manter .vscode/extensions.json e settings compartilhadas)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

